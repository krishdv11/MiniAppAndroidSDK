<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/topSummaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sample_header_card_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mini_apps"
            android:textColor="#111111"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/status_idle"
            android:textColor="#7A7A85"
            android:textSize="14sp" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/uiOptionGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/sample_segment_bg"
        android:orientation="horizontal"
        android:padding="2dp">

        <RadioButton
            android:id="@+id/rbNameOnly"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/sample_segment_option_bg"
            android:checked="true"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/ui_name_only" />

        <RadioButton
            android:id="@+id/rbNameIcon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/sample_segment_option_bg"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/ui_name_icon" />

        <RadioButton
            android:id="@+id/rbBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/sample_segment_option_bg"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/ui_banner" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/tap_any_mini_app"
        android:textColor="#7A7A85"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/miniAppUiContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

</LinearLayout>
